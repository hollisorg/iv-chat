{
  "name": "iv-chat",
  "productName": "IV Chat",
  "version": "0.1.6",
  "description": "Infinite Variance chat hub: WhatsApp, Messenger, Instagram, LinkedIn and Telegram in one place, with your AI drafting replies you send.",
  "author": "Infinite Variance",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "node --test \"test/*.test.mjs\"",
    "dist": "electron-vite build && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "big-integer": "1.6.52",
    "electron-updater": "6.8.9",
    "lottie-web": "5.12.2",
    "qrcode": "1.5.4",
    "telegram": "2.26.22",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fontsource/barlow": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.4"
  },
  "homepage": "https://infinitevariance.ai",
  "build": {
    "appId": "ai.infinitevariance.chat",
    "productName": "IV Chat",
    "copyright": "Â© 2026 Infinite Variance",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "THIRD_PARTY_NOTICES.txt",
        "to": "THIRD_PARTY_NOTICES.txt"
      },
      {
        "from": "build/licenses",
        "to": "licenses"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "IV Chat",
      "uninstallDisplayName": "IV Chat",
      "artifactName": "IV-Chat-Setup.exe",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "hollisorg",
        "repo": "iv-chat",
        "releaseType": "draft"
      }
    ]
  },
  "license": "MIT"
}
